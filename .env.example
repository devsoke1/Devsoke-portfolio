# PostgreSQL Database Connection String
# Example: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=

# Admin authentication
AUTH_SECRET=

# One-time local admin creation only
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=

# Self-Hosted Persistent Media Storage
# Example Windows: C:\DevSokeData\media
# Example Linux: /var/lib/devsoke/media
MEDIA_STORAGE_DIR=
MEDIA_MAX_FILE_SIZE_MB=8

