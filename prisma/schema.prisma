// Prisma Schema for DevSoke Portfolio Backend
// Database: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  EDITOR
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum BookingStatus {
  PENDING
  APPROVED
  CONTACTED
  COMPLETED
  ARCHIVED
}

enum InquirySource {
  BOOKING_MODAL
  CONTACT_PAGE
}

enum FaqPlacement {
  HOME
  ABOUT
  SERVICES_INDEX
  SERVICE_DETAIL
  CONTACT
}

// -----------------------------------------------------------------------------
// Admin & Auth
// -----------------------------------------------------------------------------

model AdminUser {
  id           String         @id @default(cuid())
  email        String         @unique
  name         String?
  passwordHash String
  role         AdminRole      @default(ADMIN)
  lastLoginAt  DateTime?
  sessions     AdminSession[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([email])
}

model AdminSession {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  adminUserId String
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())

  @@index([adminUserId])
  @@index([expiresAt])
}

// -----------------------------------------------------------------------------
// Services
// -----------------------------------------------------------------------------

model Service {
  id               String           @id @default(cuid())
  slug             String           @unique
  title            String
  homeTitle        String
  bookingService   String
  tagline          String
  shortDescription String
  description      String           @db.Text
  overviewHeading  String
  overview         String[]
  capabilities     String[]
  technologies     String[]
  process          Json // Array of { title: string, description: string }
  faq              Json // Array of { question: string, answer: string }
  icon             String
  homeIcon         String
  visualVariant    String
  homeGridClass    String           @default("md:col-span-1")
  order            Int              @default(0)
  isPublished      Boolean          @default(true)
  projects         ProjectService[]
  faqs             Faq[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([slug])
  @@index([isPublished, order])
}

// -----------------------------------------------------------------------------
// Projects / Portfolio Profiles
// -----------------------------------------------------------------------------

model Project {
  id              String           @id @default(cuid())
  slug            String           @unique
  title           String
  category        String
  tag             String
  desc            String           @db.Text
  longDesc        String           @db.Text
  challenge       String           @db.Text
  solution        String           @db.Text
  image           String // Legacy fallback image URL / path
  featuredMediaId String?
  featuredMedia   Media?           @relation(fields: [featuredMediaId], references: [id], onDelete: SetNull)
  tech            String[]
  client          String
  timeline        String
  demoUrl         String?
  order           Int              @default(0)
  isFeatured      Boolean          @default(false)
  isPublished     Boolean          @default(true)
  services        ProjectService[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([slug])
  @@index([category])
  @@index([isPublished, isFeatured])
  @@index([featuredMediaId])
}

// -----------------------------------------------------------------------------
// Project <-> Service Many-to-Many Join Table
// -----------------------------------------------------------------------------

model ProjectService {
  projectId String
  serviceId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([projectId, serviceId])
  @@index([serviceId])
  @@index([projectId])
}

// -----------------------------------------------------------------------------
// Blog Posts
// -----------------------------------------------------------------------------

model BlogPost {
  id              String     @id @default(cuid())
  slug            String     @unique
  title           String
  category        String
  summary         String     @db.Text
  content         String     @db.Text
  image           String // Legacy fallback image URL / path
  featuredMediaId String?
  featuredMedia   Media?     @relation(fields: [featuredMediaId], references: [id], onDelete: SetNull)
  author          String
  readTime        String     @default("5 min read")
  status          PostStatus @default(PUBLISHED)
  publishedAt     DateTime?  @default(now())
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([slug])
  @@index([status, publishedAt])
  @@index([category])
  @@index([featuredMediaId])
}

// -----------------------------------------------------------------------------
// Bookings & Inquiries
// -----------------------------------------------------------------------------

model Booking {
  id              String        @id @default(cuid())
  name            String
  email           String
  company         String?
  service         String
  budget          String
  timeline        String
  message         String?       @db.Text
  preferredDate   String
  source          InquirySource @default(BOOKING_MODAL)
  projectContext  String?
  entryPath       String?
  referrer        String?
  ctaLabel        String?
  ctaLocation     String?
  submissionToken String?       @unique
  status          BookingStatus @default(PENDING)
  notes           String?       @db.Text
  ipHash          String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([email])
  @@index([status])
  @@index([source])
  @@index([entryPath])
  @@index([referrer])
  @@index([ctaLocation])
  @@index([createdAt])
  @@index([ipHash, createdAt])
}

// -----------------------------------------------------------------------------
// Public FAQs
// -----------------------------------------------------------------------------

model Faq {
  id          String       @id @default(cuid())
  key         String       @unique
  question    String
  answer      String       @db.Text
  placement   FaqPlacement
  serviceId   String?
  service     Service?     @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  order       Int          @default(0)
  isPublished Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([placement, isPublished, order])
  @@index([serviceId])
  @@index([isPublished])
}

// -----------------------------------------------------------------------------
// Media Records (Self-Hosted Persistent Storage)
// -----------------------------------------------------------------------------

model Media {
  id               String     @id @default(cuid())
  storageKey       String     @unique // Relative storage path, e.g. "2026/09/cmth....webp"
  originalFilename String
  mimeType         String
  size             Int
  width            Int?
  height           Int?
  alt              String?
  projects         Project[]
  blogPosts        BlogPost[]
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([storageKey])
  @@index([createdAt])
}
